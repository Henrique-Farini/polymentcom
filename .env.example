# DNS públicos usados SÓ para alcançar as APIs do Polymarket
# (algumas operadoras no Brasil recusam esses endereços no DNS delas).
PUBLIC_DNS=1.1.1.1,8.8.8.8

# Chave da API do Claude para o botão "Explicar com IA".
# Crie em https://console.anthropic.com e coloque em .env.local (não em .env.example).
ANTHROPIC_API_KEY=
